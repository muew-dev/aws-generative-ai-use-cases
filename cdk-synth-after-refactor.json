        LaunchTemplateName: generativeaiusecasesdevBastionBastionInstanceLaunchTemplate5553917E
        Version:
          Fn::GetAtt:
            - BastionBastionInstanceLaunchTemplate6CE594A8
            - LatestVersionNumber
