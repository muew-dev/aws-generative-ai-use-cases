# Development Environment Configuration
# プロジェクト全体の開発環境設定

# Global settings
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:dev_password@localhost:5433/generative_ai_dev

# AWS Configuration
AWS_REGION=ap-northeast-1
BEDROCK_REGION=ap-northeast-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Authentication (Development mode)
# LOCAL_USER環境変数が設定されている場合、自動的に認証スキップモードになります
LOCAL_USER='{"domains": [{"userId":"dev-user-123", "userName":"Development User", "email":"dev@example.com"}]}'

# API Service
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Frontend (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_ENDPOINT=http://localhost:8000
NEXT_PUBLIC_SKIP_AUTH=true
NEXT_PUBLIC_DEV_USER_ID=dev-user-123
NEXT_PUBLIC_DEV_USER_EMAIL=dev@example.com

# 本番環境用Cognito設定（実際の値に置き換えてください）
NEXT_PUBLIC_AWS_REGION=ap-northeast-1
# NEXT_PUBLIC_USER_POOL_ID=your-user-pool-id
# NEXT_PUBLIC_USER_POOL_CLIENT_ID=your-client-id
# NEXT_PUBLIC_IDENTITY_POOL_ID=your-identity-pool-id
# NEXT_PUBLIC_COGNITO_LOGIN_URL=/login
# NEXT_PUBLIC_COGNITO_LOGOUT_URL=/logout

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Placeholder S3 settings
S3_MEDIA_BUCKET_NAME=generative-ai-media-bucket-dev
S3_REGION=ap-northeast-1