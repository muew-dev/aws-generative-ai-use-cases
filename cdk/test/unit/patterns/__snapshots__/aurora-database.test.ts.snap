exports[`AuroraDatabase Pattern Environment: dev (development) snapshot test for AuroraDatabase pattern - development: aurora-database-dev 1`] = `
{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "TestAuroraDatabaseAuroraClusterD678395E": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "BackupRetentionPeriod": 7,
        "CopyTagsToSnapshot": true,
        "DBClusterIdentifier": "test-cluster-dev",
        "DBClusterParameterGroupName": "default.aurora-postgresql17",
        "DBSubnetGroupName": {
          "Ref": "TestAuroraDatabaseDatabaseSubnetGroupF860730E",
        },
        "DatabaseName": "testdb",
        "DeletionProtection": false,
        "EnableHttpEndpoint": true,
        "Engine": "aurora-postgresql",
        "EngineVersion": "17.5",
        "MasterUserPassword": {
          "Fn::Join": [
            "",
            [
              "{{resolve:secretsmanager:",
              {
                "Ref": "TestAuroraDatabaseDatabaseSecretDB0F5C36",
              },
              ":SecretString:password::}}",
            ],
          ],
        },
        "MasterUsername": {
          "Fn::Join": [
            "",
            [
              "{{resolve:secretsmanager:",
              {
                "Ref": "TestAuroraDatabaseDatabaseSecretDB0F5C36",
              },
              ":SecretString:username::}}",
            ],
          ],
        },
        "Port": 5432,
        "StorageEncrypted": true,
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "TestAuroraDatabaseDatabaseSecurityGroup21740734",
              "GroupId",
            ],
          },
        ],
      },
      "Type": "AWS::RDS::DBCluster",
      "UpdateReplacePolicy": "Delete",
    },
    "TestAuroraDatabaseAuroraClusterwriterFEC8BA91": {
      "DeletionPolicy": "Delete",
      "DependsOn": [
        "TestVpcDatabaseSubnet1RouteTableAssociationE6669ECB",
        "TestVpcDatabaseSubnet2RouteTableAssociation3ADF1676",
      ],
      "Properties": {
        "DBClusterIdentifier": {
          "Ref": "TestAuroraDatabaseAuroraClusterD678395E",
        },
        "DBInstanceClass": "db.t3.medium",
        "DBInstanceIdentifier": "writer-instance",
        "Engine": "aurora-postgresql",
        "PromotionTier": 0,
        "PubliclyAccessible": false,
      },
      "Type": "AWS::RDS::DBInstance",
      "UpdateReplacePolicy": "Delete",
    },
    "TestAuroraDatabaseDatabaseSecretAttachmentDCF2216E": {
      "Properties": {
        "SecretId": {
          "Ref": "TestAuroraDatabaseDatabaseSecretDB0F5C36",
        },
        "TargetId": {
          "Ref": "TestAuroraDatabaseAuroraClusterD678395E",
        },
        "TargetType": "AWS::RDS::DBCluster",
      },
      "Type": "AWS::SecretsManager::SecretTargetAttachment",
    },
    "TestAuroraDatabaseDatabaseSecretDB0F5C36": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "Description": "Aurora PostgreSQL master credentials",
        "GenerateSecretString": {
          "ExcludeCharacters": " %+~\`#$&*()|[]{}:;<>?!'/@"\\",
          "GenerateStringKey": "password",
          "IncludeSpace": false,
          "PasswordLength": 32,
          "SecretStringTemplate": "{"username":"testuser"}",
        },
        "Name": "test-secret-dev",
      },
      "Type": "AWS::SecretsManager::Secret",
      "UpdateReplacePolicy": "Delete",
    },
    "TestAuroraDatabaseDatabaseSecurityGroup21740734": {
      "Properties": {
        "GroupDescription": "Security group for Aurora PostgreSQL cluster",
        "SecurityGroupEgress": [
          {
            "CidrIp": "255.255.255.255/32",
            "Description": "Disallow all traffic",
            "FromPort": 252,
            "IpProtocol": "icmp",
            "ToPort": 86,
          },
        ],
        "VpcId": {
          "Ref": "TestVpcE77CE678",
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "TestAuroraDatabaseDatabaseSubnetGroupF860730E": {
