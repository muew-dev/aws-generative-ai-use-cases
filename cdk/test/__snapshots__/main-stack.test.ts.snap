    "BedrockRagS3DataSource1DA41911": {
      "DependsOn": [
        "BedrockRagKnowledgeBase0C46C23C",
      ],
      "Properties": {
        "DataSourceConfiguration": {
          "S3Configuration": {
            "BucketArn": {
              "Fn::GetAtt": [
                "RagDocumentsRagDocumentBucket2AF1B294",
                "Arn",
              ],
            },
            "InclusionPrefixes": [
              "documents/",
            ],
          },
          "Type": "S3",
        },
        "Description": "文書アップロード用S3データソース",
        "KnowledgeBaseId": {
          "Fn::GetAtt": [
            "BedrockRagKnowledgeBase0C46C23C",
            "KnowledgeBaseId",
          ],
        },
        "Name": "s3-datasource-dev",
        "VectorIngestionConfiguration": {
          "ChunkingConfiguration": {
            "ChunkingStrategy": "FIXED_SIZE",
            "FixedSizeChunkingConfiguration": {
              "MaxTokens": 512,
              "OverlapPercentage": 20,
            },
          },
        },
      },
