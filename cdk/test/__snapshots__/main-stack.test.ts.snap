    "BastionBastionInstance17613F1A": {
      "DependsOn": [
        "BastionBastionRoleDefaultPolicyA5E1C57E",
        "BastionBastionRole0D06DDB9",
      ],
      "Properties": {
        "AvailabilityZone": "ap-northeast-1a",
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "DeleteOnTermination": true,
              "Encrypted": true,
              "VolumeSize": 30,
              "VolumeType": "gp3",
            },
          },
        ],
        "IamInstanceProfile": {
          "Ref": "BastionBastionInstanceInstanceProfile7DF9477B",
        },
        "ImageId": {
          "Ref": "SsmParameterValueawsserviceamiamazonlinuxlatestal2023amikernel61x8664C96584B6F00A464EAD1953AFF4B05118Parameter",
        },
        "InstanceType": "t3.micro",
        "LaunchTemplate": {
          "LaunchTemplateName": "BastionInstanceLaunchTemplate",
          "Version": {
            "Fn::GetAtt": [
              "BastionBastionInstanceLaunchTemplate6CE594A8",
              "LatestVersionNumber",
            ],
          },
        },
        "SecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "BastionBastionSecurityGroupED5052E4",
              "GroupId",
            ],
          },
        ],
        "SubnetId": {
          "Ref": "VPCVpcPrivateSubnet1Subnet99F2AD5A",
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "generative-ai-use-cases-dev-HASH-REPLACEDstion-host",
          },
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash
#!/bin/bash
set -e

# システムアップデート
dnf update -y

# SSM Agent インストール・起動（最新Amazon Linuxでは標準インストール済み）
dnf install -y amazon-ssm-agent
systemctl enable amazon-ssm-agent
systemctl start amazon-ssm-agent

# PostgreSQL CLI ツールインストール
dnf install -y postgresql15

# 便利ツールのインストール
dnf install -y htop nano curl wget git

# ログ出力
echo "Bastion Host initialization completed at $(date)" >> /var/log/bastion-init.log",
        },
      },
      "Type": "AWS::EC2::Instance",
    },
